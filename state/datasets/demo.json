    {"id": "clean",   "name": "清洗后数据", "kind": "processed", "desc": "去重与过滤后的训练候选集。",
     "meta": {"storage": "共享盘A", "size_bytes": 1800000000, "count": 69999, "format": "jsonl", "version": "v2", "updated": "2026-10-03"}},
    {"id": "bench",   "name": "评测集", "kind": "external",  "desc": "公开评测集的本地副本。",
     "meta": {"storage": "共享盘B", "size_bytes": 7400000000, "count": 15000, "format": "parquet", "version": "2026-09"}},
    {"id": "labels",  "name": "模型标注结果", "kind": "derived", "status": "building", "desc": "由模型生成的参考答案，正在生成。",
     "meta": {"storage": "本地盘", "size_bytes": 300000000, "count": 40000, "format": "jsonl", "version": "v1"}},
    {"id": "weights", "name": "模型权重", "kind": "model",     "status": "pending", "desc": "训练产出，尚未生成。",
     "meta": {"storage": "共享盘B", "format": "safetensors"}}
  ],
  "edges": [
    {"from": "raw", "to": "clean", "label": "清洗"},
    {"from": "clean", "to": "labels", "label": "模型标注"},
    {"from": "clean", "to": "weights", "label": "训练"},
    {"from": "labels", "to": "weights"},
    {"from": "bench", "to": "weights", "label": "评测"}
  ]
